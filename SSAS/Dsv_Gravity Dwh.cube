  <MdxScripts>
    <MdxScript dwd:design-time-name="3ee63cb5-2db2-4659-a327-135a31f6492a">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
/*  Default aggregation  */
CALCULATE;

/*  Derived measures  */
CREATE MEMBER CURRENTCUBE.[Measures].[Total Revenue]
 AS [Measures].[Price],
 FORMAT_STRING = "$#,##0.00",
 VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Total Amount]
 AS ([Measures].[Price] + [Measures].[Shipping Cost]),
 FORMAT_STRING = "$#,##0.00",
 VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Average Order Value]
 AS IIF([Measures].[Order Line Count] &lt;&gt; 0,
        [Measures].[Price] / [Measures].[Order Line Count],
        NULL),
 FORMAT_STRING = "$#,##0.00",
 VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Shipping Cost Ratio]
 AS IIF([Measures].[Total Amount] &lt;&gt; 0,
        [Measures].[Shipping Cost] / [Measures].[Total Amount],
        NULL),
 FORMAT_STRING = "0.00%",
 VISIBLE = 1;</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>