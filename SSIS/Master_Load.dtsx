          SQLTask:SqlStatementSource="-- Step 1: DROP all FK constraints&#xA;ALTER TABLE dbo.Bridge_BookAuthor DROP CONSTRAINT FK_Bridge_BookAuthor_Dim_Book;&#xA;ALTER TABLE dbo.Fact_OrderLine    DROP CONSTRAINT fk_fact_book;&#xA;ALTER TABLE dbo.Fact_OrderLine    DROP CONSTRAINT fk_fact_customer;&#xA;ALTER TABLE dbo.Fact_OrderLine    DROP CONSTRAINT fk_fact_date;&#xA;ALTER TABLE dbo.Fact_OrderLine    DROP CONSTRAINT fk_fact_status;&#xA;ALTER TABLE dbo.Fact_OrderLine    DROP CONSTRAINT fk_fact_shipping;&#xA;&#xA;-- Step 2: TRUNCATE all tables&#xA;TRUNCATE TABLE dbo.Fact_OrderLine;&#xA;TRUNCATE TABLE dbo.Bridge_BookAuthor;&#xA;TRUNCATE TABLE dbo.Dim_Author;&#xA;TRUNCATE TABLE dbo.Dim_Book;&#xA;TRUNCATE TABLE dbo.Dim_Customer;&#xA;TRUNCATE TABLE dbo.Dim_OrderStatus;&#xA;TRUNCATE TABLE dbo.Dim_Shipping;&#xA;&#xA;-- Step 3: RECREATE all FK constraints&#xA;ALTER TABLE dbo.Bridge_BookAuthor ADD CONSTRAINT FK_Bridge_BookAuthor_Dim_Book&#xA;    FOREIGN KEY (book_sk) REFERENCES dbo.Dim_Book(book_sk);&#xA;&#xA;ALTER TABLE dbo.Fact_OrderLine ADD CONSTRAINT fk_fact_book&#xA;    FOREIGN KEY (book_sk) REFERENCES dbo.Dim_Book(book_sk);&#xA;&#xA;ALTER TABLE dbo.Fact_OrderLine ADD CONSTRAINT fk_fact_customer&#xA;    FOREIGN KEY (customer_sk) REFERENCES dbo.Dim_Customer(customer_sk);&#xA;&#xA;ALTER TABLE dbo.Fact_OrderLine ADD CONSTRAINT fk_fact_date&#xA;    FOREIGN KEY (date_sk) REFERENCES dbo.Dim_Date(date_sk);&#xA;&#xA;ALTER TABLE dbo.Fact_OrderLine ADD CONSTRAINT fk_fact_status&#xA;    FOREIGN KEY (status_sk) REFERENCES dbo.Dim_OrderStatus(status_sk);&#xA;&#xA;ALTER TABLE dbo.Fact_OrderLine ADD CONSTRAINT fk_fact_shipping&#xA;    FOREIGN KEY (shipping_sk) REFERENCES dbo.Dim_Shipping(shipping_sk);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
